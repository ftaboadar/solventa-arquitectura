@startuml Diagrama_Contexto_Solventa

left to right direction
skinparam backgroundColor #FAFAFA
skinparam ArrowColor #555555
skinparam ArrowFontSize 10
skinparam ArrowFontColor #333333

skinparam actor {
    BackgroundColor #DDEEFF
    BorderColor #1565C0
    FontColor #1A237E
    FontSize 10
    BorderThickness 1.5
}

skinparam usecase {
    BackgroundColor #1565C0
    BorderColor #0D47A1
    FontColor #FFFFFF
    FontSize 12
    BorderThickness 2.5
}

skinparam rectangle {
    FontSize 10
    BackgroundColor<<datos>>     #E8F5E9
    BorderColor<<datos>>         #2E7D32
    FontColor<<datos>>           #1B5E20
    BackgroundColor<<operacion>> #FFF3E0
    BorderColor<<operacion>>     #E65100
    FontColor<<operacion>>       #BF360C
    BackgroundColor<<gobierno>>  #F3E5F5
    BorderColor<<gobierno>>      #6A1B9A
    FontColor<<gobierno>>        #4A148C
}

' ============================================================
' ACTORES (figura de persona)
' ============================================================
actor "Cliente asegurado\n(Web y Móvil)" as Cliente
actor "Asesores / Venta asistida\n(Canal Web)" as Asesor
actor "Socios de distribución\n(Bancos, aerolíneas, fintech)" as Socio
actor "Áreas internas\n(Actuaría, CISO, Cumplimiento)" as Interno

' ============================================================
' SISTEMA CENTRAL (ovalo)
' ============================================================
usecase "SOLVENTA\nSistema de Seguros Digitales\ny Finanzas Abiertas" as Solventa

' ============================================================
' FUENTES DE DATOS (rectangulos verdes)
' ============================================================
rectangle "Open Finance\n(Datos financieros consentidos)" as OpenFinance <<datos>>
rectangle "Open Data\n(Fuentes publicas)" as OpenData <<datos>>
rectangle "Telemetria / IoT\n(Clima, movilidad, vuelos)" as IoT <<datos>>

' ============================================================
' SERVICIOS OPERACIONALES (rectangulos naranja)
' ============================================================
rectangle "Proveedor KYC / AML\ne Identidad" as KYC <<operacion>>
rectangle "Pasarelas de pago\ny recaudo" as Pagos <<operacion>>
rectangle "Firma electronica\ny notificaciones" as Firma <<operacion>>
rectangle "Peritos, talleres\ny prestadores" as Servicios <<operacion>>

' ============================================================
' GOBIERNO Y NORMA (rectangulos morados)
' ============================================================
rectangle "Reaseguradoras" as Reaseg <<gobierno>>
rectangle "Superintendencia Financiera\ny proteccion de datos" as Regulador <<gobierno>>
rectangle "Estandares del sector\n(ACORD)" as ACORD <<gobierno>>
rectangle "Sistemas Analiticos / BI\ny Modelos de Fraude" as Analitica <<gobierno>>

' ============================================================
' RELACIONES - Actores
' ============================================================
Cliente --> Solventa : Cotiza, gestiona siniestros\ny administra consentimiento
Asesor  --> Solventa : Venta asistida y radicacion
Socio   --> Solventa : Consume API Embedded
Solventa --> Socio  : Cotizacion y catalogo
Interno --> Solventa : Administra reglas y audita

' ============================================================
' RELACIONES - Fuentes de datos
' ============================================================
Solventa ..> OpenFinance : Consulta datos consentidos
Solventa ..> OpenData    : Consulta fuentes publicas
IoT      ..> Solventa    : Dispara pago parametrico

' ============================================================
' RELACIONES - Servicios operacionales
' ============================================================
Solventa ..> KYC      : Solicita validacion
KYC      ..> Solventa : Retorna score
Solventa ..> Pagos    : Solicita cobro
Pagos    ..> Solventa : Confirma pago
Solventa ..> Firma    : Envia a firma
Firma    ..> Solventa : Retorna evidencia
Solventa ..> Servicios : Asigna inspeccion
Servicios ..> Solventa : Retorna dictamen

' ============================================================
' RELACIONES - Gobierno y norma
' ============================================================
Solventa  ..> Reaseg    : Cede riesgo
Reaseg    ..> Solventa  : Retorna condiciones
Solventa  ..> Regulador : Envia reportes
Regulador ..> Solventa  : Emite normatividad
Solventa  ..> ACORD     : Mapea estandares
Solventa  ..> Analitica : Envia eventos y linaje

' ============================================================
' LEYENDA
' ============================================================
legend bottom
  <u><b>Convenciones del Diagrama de Contexto</b></u>
  |= Elemento                    |= Tipo                 |= Descripcion                                 |
  |<#DDEEFF> <color:#1565C0><b> <&person> </b></color> Figura humana | Actor / Usuario        | Persona que interactua directamente con el sistema |
  |<#1565C0> <color:#FFFFFF><b> <&media-record> </b></color> Ovalo central  | Sistema central        | SOLVENTA: sistema bajo diseno y desarrollo    |
  |<#E8F5E9> <color:#2E7D32><b> <&media-stop> </b></color> Rectangulo verde | Fuente de datos        | Open Finance, Open Data, Telemetria / IoT    |
  |<#FFF3E0> <color:#E65100><b> <&media-stop> </b></color> Rectangulo naranja| Servicio operacional   | KYC, Pagos, Firma electronica, Prestadores   |
  |<#F3E5F5> <color:#6A1B9A><b> <&media-stop> </b></color> Rectangulo morado | Gobierno y norma       | Reaseguradoras, Regulador, ACORD, Analitica  |
  | ──►  Flecha continua          | Interaccion directa   | Usuarios / Actores interactuando con el sistema |
  | ─ ─► Flecha punteada          | Integracion externa   | API, Webhooks o archivos con sistemas externos  |
endlegend

@enduml
